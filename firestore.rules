rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.email == 'datacore.solutionswork@gmail.com'; }
    function trialActive(uid) {
      return signedIn() && request.auth.uid == uid &&
        exists(/databases/$(database)/documents/trialAccounts/$(uid)) &&
        get(/databases/$(database)/documents/trialAccounts/$(uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/trialAccounts/$(uid)).data.expiresAt > request.time;
    }
    match /trialAccounts/{uid} {
      allow read: if owner() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if owner();
    }
    match /tenants/{uid}/{coll}/{docId} {
      allow read, write: if trialActive(uid);
    }
    match /{coll}/{docId} {
      allow read, write: if owner() && coll in ['settings','products','sales','purchases','customers','suppliers','employees','expenses','payments'];
    }
  }
}