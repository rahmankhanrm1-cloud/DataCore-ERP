rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'datacore.solutionswork@gmail.com'
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function active(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/trialAccounts/$(uid))
        && get(/databases/$(database)/documents/trialAccounts/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/trialAccounts/$(uid)).data.createdAt + duration.value(72, 'h') > request.time;
    }
    match /trialAccounts/{uid} {
      allow read: if owner() || (request.auth != null && request.auth.uid == uid);
      allow create: if owner() && request.resource.data.createdAt == request.time;
      allow update, delete: if owner() && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /tenants/{uid}/{coll}/{docId} {
      allow read, write: if active(uid) && coll in ['settings','products','sales','purchases','customers','suppliers','employees','expenses','payments','invoices','attendance','payroll','menuItems','services','parts'];
    }
    match /{coll}/{docId} {
      allow read, write: if owner() && coll in ['settings','products','sales','purchases','customers','suppliers','employees','expenses','payments'];
    }
  }
}